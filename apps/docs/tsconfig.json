{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/components/*": ["../../packages/design-system/src/components/*"],
      "@/lib/*": ["../../packages/design-system/src/lib/*"],
      "@/hooks/*": ["../../packages/design-system/src/hooks/*"],
      "@/types/*": ["../../packages/design-system/src/types/*"],
      "@/theme": ["../../packages/design-system/src/theme/index.ts"],
      "@/theme/*": ["../../packages/design-system/src/theme/*"],
      "@/ai/*": ["../../packages/ai/src/ai/*"],
      "@/design-system/data/*": ["../../packages/ai/src/design-system/data/*"],
      "@/*": ["./src/*"],
      "@winniekagz/componentiq": ["../../packages/design-system/src/index.ts"],
      "@winniekagendo/componentiq-ai": ["../../packages/ai/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "../../packages/design-system/src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**"
  ]
}
