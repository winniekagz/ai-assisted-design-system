{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/lib/api/*": ["./src/lib/api/*"],
      "@/lib/query/*": ["./src/lib/query/*"],
      "@/hooks/queries/*": ["./src/hooks/queries/*"],
      "@/hooks/mutations/*": ["./src/hooks/mutations/*"],
      "@/stores/*": ["./src/stores/*"],
      "@/lib/auth/*": ["./src/lib/auth/*"],
      "@/components/*": ["../../packages/design-system/src/components/*"],
      "@/lib/*": ["../../packages/design-system/src/lib/*"],
      "@/hooks/*": ["../../packages/design-system/src/hooks/*"],
      "@/types/*": ["../../packages/design-system/src/types/*"],
      "@/theme": ["../../packages/design-system/src/theme/index.ts"],
      "@/theme/*": ["../../packages/design-system/src/theme/*"],
      "@/ai/*": ["../../packages/ai/src/ai/*"],
      "@/design-system/data/*": ["../../packages/ai/src/design-system/data/*"],
      "@/*": ["./src/*"],
      "componentiq": ["../../packages/design-system/src/index.ts"],
      "@winniekagendo/componentiq-ai": ["../../packages/ai/src/index.ts"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts", ".next/types/**/*.ts", ".next-build/types/**/*.ts"],
  "exclude": ["node_modules"]
}
