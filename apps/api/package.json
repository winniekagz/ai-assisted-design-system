{
  "name": "@winniekagendo/componentiq-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/apps/api/src/main.js",
    "start:prod": "node dist/apps/api/src/main.js",
    "lint": "eslint src --ext .ts",
    "test": "npm run build:lib --workspace=@winniekagendo/componentiq-shared-types && vitest run test",
    "type-check": "tsc --noEmit",
    "typecheck": "npm run type-check",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.13",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "@winniekagendo/componentiq-shared-types": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "openai": "^4.77.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "node -r ts-node/register -r tsconfig-paths/register prisma/seed.ts"
  }
}
