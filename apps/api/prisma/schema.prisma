generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MAINTAINER
  ENGINEER
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GuardrailCategory {
  ACCESSIBILITY
  DESIGN_TOKENS
  COMPONENT_USAGE
  UI_STATES
  COPY
  AI_SAFETY
}

enum PromptType {
  COMPONENT_RECOMMENDATION
  PRE_PR_AUDIT
  SETUP_GUIDANCE
  DECISION_SUMMARY
}

enum AuditStatus {
  PASSED
  NEEDS_CHANGES
  FAILED
}

enum ProjectConfigurationStatus {
  NOT_CONFIGURED
  CONFIGURING
  REVIEW_REQUIRED
  READY
  CONFIGURATION_FAILED
  ARCHIVED
}

enum ConfigurationSourceType {
  LOCAL_UPLOAD
  GIT_REPOSITORY
}

enum ConfigurationJobStatus {
  PENDING
  UPLOADING
  ANALYZING
  REVIEW_REQUIRED
  COMPLETED
  FAILED
  CANCELLED
}

enum SourceProvider {
  LOCAL
  GITHUB
}

enum ProjectSourceType {
  LOCAL_UPLOAD
  GITHUB_REPOSITORY
}

enum SourceConnectionStatus {
  ACTIVE
  DISCONNECTED
  REVOKED
  FAILED
}

enum GitProviderConnectionStatus {
  ACTIVE
  DISCONNECTED
  REVOKED
  FAILED
}

model User {
  id                             String                          @id @default(uuid())
  clerkUserId                    String?                         @unique
  name                           String?
  email                          String                          @unique
  imageUrl                       String?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  memberships                    OrganizationMember[]
  sentInvites                    OrganizationInvite[]            @relation("InvitedBy")
  recommendations                RecommendationSession[]
  audits                         AuditSession[]
  usageLogs                      AiUsageLog[]
  createdProjectSources          ProjectSource[]                 @relation("ProjectSourceCreatedBy")
  connectedGitProviders          GitProviderConnection[]         @relation("GitProviderConnectionConnectedBy")
  confirmedProjectConfigurations ConfirmedProjectConfiguration[] @relation("ProjectConfigurationConfirmedBy")
}

model Organization {
  id                             String                          @id @default(uuid())
  name                           String
  slug                           String                          @unique
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  members                        OrganizationMember[]
  invites                        OrganizationInvite[]
  projects                       Project[]
  configurationJobs              ConfigurationJob[]
  projectSources                 ProjectSource[]
  gitProviderConnections         GitProviderConnection[]
  confirmedProjectConfigurations ConfirmedProjectConfiguration[]
  components                     Component[]
  guardrails                     Guardrail[]
  promptTemplates                PromptTemplate[]
  recommendations                RecommendationSession[]
  audits                         AuditSession[]
  usageLogs                      AiUsageLog[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model OrganizationInvite {
  id              String       @id @default(uuid())
  organizationId  String
  email           String
  role            Role
  tokenHash       String       @unique
  invitedByUserId String
  status          InviteStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy       User         @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([status])
}

model Project {
  id                     String                         @id @default(uuid())
  organizationId         String
  name                   String
  slug                   String
  description            String?
  framework              String
  packageManager         String
  stylingSystem          String
  repositoryUrl          String?
  configurationStatus    ProjectConfigurationStatus     @default(NOT_CONFIGURED)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  organization           Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configurationJobs      ConfigurationJob[]
  sources                ProjectSource[]
  confirmedConfiguration ConfirmedProjectConfiguration?
  recommendations        RecommendationSession[]
  audits                 AuditSession[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, configurationStatus])
}

model ConfigurationJob {
  id                            String                         @id @default(uuid())
  projectId                     String
  organizationId                String
  projectSourceId               String?
  sourceType                    ConfigurationSourceType
  status                        ConfigurationJobStatus         @default(PENDING)
  progress                      Int?
  errorCode                     String?
  errorMessage                  String?
  startedAt                     DateTime?
  completedAt                   DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  project                       Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectSource                 ProjectSource?                 @relation(fields: [projectSourceId], references: [id], onDelete: SetNull)
  detectedConfiguration         DetectedConfiguration?
  confirmedProjectConfiguration ConfirmedProjectConfiguration?

  @@index([projectId])
  @@index([projectId, createdAt])
  @@index([organizationId])
  @@index([projectSourceId])
  @@index([status])
}

model ProjectSource {
  id                   String                 @id @default(uuid())
  organizationId       String
  projectId            String
  type                 ProjectSourceType
  status               SourceConnectionStatus @default(ACTIVE)
  provider             SourceProvider
  providerConnectionId String?
  repositoryId         String?
  repositoryOwner      String?
  repositoryName       String?
  repositoryFullName   String?
  defaultBranch        String?
  selectedBranch       String?
  projectRoot          String?
  latestCommitSha      String?
  sourceSnapshotId     String?
  artifactPath         String?
  artifactChecksum     String?
  originalName         String?
  fileCount            Int?
  totalBytes           Int?
  retainedUntil        DateTime?
  createdByUserId      String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  providerConnection   GitProviderConnection? @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  createdBy            User?                  @relation("ProjectSourceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  configurationJobs    ConfigurationJob[]

  @@index([projectId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([providerConnectionId])
  @@index([sourceSnapshotId])
}

model GitProviderConnection {
  id                String                      @id @default(uuid())
  organizationId    String
  provider          SourceProvider              @default(GITHUB)
  installationId    String
  externalAccountId String?
  accountLogin      String
  accountType       String?
  status            GitProviderConnectionStatus @default(ACTIVE)
  connectedByUserId String?
  installedAt       DateTime?
  lastVerifiedAt    DateTime?
  disconnectedAt    DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy       User?                       @relation("GitProviderConnectionConnectedBy", fields: [connectedByUserId], references: [id], onDelete: SetNull)
  projectSources    ProjectSource[]

  @@unique([organizationId, installationId])
  @@index([organizationId])
  @@index([installationId])
  @@index([status])
}

model DetectedConfiguration {
  id                 String           @id @default(uuid())
  configurationJobId String           @unique
  framework          String?
  language           String?
  packageManager     String?
  stylingSystem      String?
  projectRoot        String?
  componentPaths     Json?
  tokenPaths         Json?
  monorepoDetected   Boolean          @default(false)
  storybookDetected  Boolean          @default(false)
  confidence         String?
  evidence           Json?
  rawDetectionResult Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  configurationJob   ConfigurationJob @relation(fields: [configurationJobId], references: [id], onDelete: Cascade)
}

model ConfirmedProjectConfiguration {
  id                 String                   @id @default(uuid())
  projectId          String                   @unique
  organizationId     String
  configurationJobId String?                  @unique
  sourceType         ConfigurationSourceType?
  framework          String?
  language           String?
  packageManager     String?
  stylingSystem      String?
  projectRoot        String?
  componentPaths     Json?
  tokenPaths         Json?
  notes              String?
  confirmedByUserId  String?
  confirmedAt        DateTime                 @default(now())
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  project            Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configurationJob   ConfigurationJob?        @relation(fields: [configurationJobId], references: [id], onDelete: SetNull)
  confirmedBy        User?                    @relation("ProjectConfigurationConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([confirmedByUserId])
}

model Component {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  description    String
  category       String
  docsUrl        String?
  storybookUrl   String?
  status         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules          ComponentRule[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ComponentRule {
  id          String    @id @default(uuid())
  componentId String
  ruleType    String
  ruleText    String
  severity    Severity
  exampleGood String?
  exampleBad  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@index([componentId])
}

model Guardrail {
  id             String            @id @default(uuid())
  organizationId String
  category       GuardrailCategory
  title          String
  ruleText       String
  severity       Severity
  enabled        Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model PromptTemplate {
  id                 String        @id @default(uuid())
  organizationId     String?
  type               PromptType
  name               String
  systemPrompt       String
  userPromptTemplate String?
  outputSchema       Json?
  version            Int           @default(1)
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, active])
}

model RecommendationSession {
  id                   String                      @id @default(uuid())
  organizationId       String
  projectId            String?
  userId               String?
  userGoal             String
  recommendedComponent String
  confidence           String
  reasoning            String
  prNote               String?
  rawResponse          Json?
  createdAt            DateTime                    @default(now())
  alternatives         RecommendationAlternative[]
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project              Project?                    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user                 User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
}

model RecommendationAlternative {
  id            String                @id @default(uuid())
  sessionId     String
  componentName String
  reason        String
  tradeoff      String?
  session       RecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AuditSession {
  id             String         @id @default(uuid())
  organizationId String
  projectId      String?
  userId         String?
  auditType      String
  inputType      String
  inputContent   String
  status         AuditStatus
  summary        String
  rawResponse    Json?
  createdAt      DateTime       @default(now())
  findings       AuditFinding[]
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
}

model AuditFinding {
  id             String       @id @default(uuid())
  auditSessionId String
  severity       Severity
  category       String
  issue          String
  suggestion     String
  ruleUsed       String?
  filePath       String?
  lineNumber     Int?
  docsLink       String?
  createdAt      DateTime     @default(now())
  auditSession   AuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)

  @@index([auditSessionId])
}

model AiUsageLog {
  id             String        @id @default(uuid())
  organizationId String?
  userId         String?
  feature        String
  model          String
  inputTokens    Int?
  outputTokens   Int?
  costEstimate   Decimal?      @db.Decimal(10, 6)
  latencyMs      Int?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
}
