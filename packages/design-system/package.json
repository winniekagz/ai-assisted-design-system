{
  "name": "componentiq",
  "version": "1.0.7",
  "description": "A reusable React UI component library built with TypeScript and Tailwind CSS.",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winniekagz/ai-assisted-design-system.git",
    "directory": "packages/design-system"
  },
  "homepage": "https://github.com/winniekagz/ai-assisted-design-system#readme",
  "bugs": {
    "url": "https://github.com/winniekagz/ai-assisted-design-system/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:lib": "tsup",
    "prepublishOnly": "npm run build:lib",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --ignore-pattern \"src/components/examples/**\" --ignore-pattern \"src/**/*.stories.tsx\""
  },
  "dependencies": {
    "@heroui/react": "^3.0.3",
    "@hookform/resolvers": "^5.2.1",
    "@internationalized/date": "^3.12.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/table-core": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.0",
    "react-hook-form": "^7.62.0",
    "react-tailwindcss-datepicker": "^2.0.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.14"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/nextjs-vite": "^9.1.1",
    "@types/lodash": "^4.17.20",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsup": "^8.5.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.46.2",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.1.11",
    "lightningcss-linux-x64-gnu": "1.30.1"
  }
}
