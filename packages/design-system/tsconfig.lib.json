{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "incremental": false,
    "noEmit": false,
    "outDir": "dist",
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "src/index.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/hooks/**/*.ts",
    "src/hooks/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/theme/**/*.ts",
    "src/theme/**/*.tsx",
    "src/types/**/*.ts",
    "src/types/**/*.tsx"
  ],
  "exclude": ["node_modules", "src/components/examples/**"]
}
