{
  "name": "componentiq-monorepo",
  "private": true,
  "packageManager": "npm@9.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:lib": "turbo build:lib",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "npm run dev --workspace=@winniekagendo/componentiq-api",
    "db:migrate": "npm run db:migrate --workspace=@winniekagendo/componentiq-api",
    "db:seed": "npm run db:seed --workspace=@winniekagendo/componentiq-api",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "storybook": "npm run storybook --workspace=apps/docs",
    "build-storybook": "npm run build-storybook --workspace=apps/docs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5"
  }
}
