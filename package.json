{
  "name": "@winniekagendo/componentiq",
  "version": "1.0.3",
  "description": "A reusable React UI component library built with TypeScript and Tailwind CSS.",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winniekagz/ai-assisted-design-system.git"
  },
  "homepage": "https://github.com/winniekagz/ai-assisted-design-system#readme",
  "bugs": {
    "url": "https://github.com/winniekagz/ai-assisted-design-system/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:lib": "tsup",
    "prepublishOnly": "npm run build:lib",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "lint:check": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix-all": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "code-quality": "npm run lint:check && npm run format:check && npm run type-check",
    "chromatic": "npx chromatic --project-token=chpt_ed90d514739b3ee"
  },
