{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "build:lib": {
      "dependsOn": ["^build:lib"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "AI_PROVIDER",
        "CLERK_SECRET_KEY",
        "DATABASE_URL",
        "EMAIL_FROM",
        "FRONTEND_URL",
        "OPENAI_API_KEY",
        "OPENAI_MODEL",
        "PORT",
        "RESEND_API_KEY"
      ]
    },
    "lint": {
      "dependsOn": ["^build:lib"]
    },
    "type-check": {
      "dependsOn": ["^build:lib", "prisma:generate"]
    },
    "prisma:generate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["^build:lib"],
      "cache": false
    }
  }
}
